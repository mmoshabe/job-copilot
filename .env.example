# Copy to .env (gitignored)
ANTHROPIC_API_KEY=
# Dashboard login + session signing (generate: python3 -c "import secrets;print(secrets.token_hex(32))")
JOBS_DASHBOARD_PASSWORD=
JOBS_SESSION_SECRET=
# Optional
JOBS_MODEL=claude-opus-5-5
JOBS_MONTHLY_BUDGET_USD=5
JOBS_FOLLOW_UP_DAYS=7
# DATABASE_URL comes from `vercel env pull .env.local` (Neon); unset = local SQLite in data/
